From 0486bb28d0cd243a7c4f6158ae465539a21a08a7 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 17 Aug 2026 23:59:47 +0000
Subject: [PATCH] fix(growth): repair metadata regex literals broken by escape
 stripping
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

7ac32b9 correctly un-escaped the template literals my patch shipped mangled, but
three REGEX LITERALS were over-corrected in the same pass. Inside /.../ a "\\s"
is a literal backslash followed by s — not whitespace — so these never matched
anything:

  canonicalOf()   /<link[^>]+rel\\s*=\\s*["']canonical["'].../
  schemaTypes()   /<script[^>]+type\\s*=\\s*["']application\/ld\\+json["']...>([\\s\\S]*?).../
  metaContent()   key.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\$&')

metaContent's OTHER patterns were fine: they are built with new RegExp() from
template literals, where "\\s" correctly collapses to "\s". Only the literals
were wrong, which is exactly why it was invisible — Open Graph and Twitter tags
parsed correctly while canonical and structured data silently did not.

Impact was worse than "a field is empty". canonical_url was always null and
schema_types always [], so scoreMetadata() penalised EVERY audited page with
canonical_missing (-10) and schema_localbusiness_missing (-15) regardless of the
page's real markup. Boutiques would have been told to fix things that were
already correct, and their social score understated by 25 points — wrong data
presented confidently, which is the worst failure mode for a reporting product.

Demonstrated on markup containing both tags:
  before  canonical: null,  json-ld: 0 blocks
  after   canonical: https://…/gowns,  json-ld: 1 block

Worker tests 21/21 (was 18/21 — the three metadata failures were real and had
been failing on main since the escape-stripping commit).

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AAqkh5ZVeoEB5REorRbMyZ
---
 .../worker/src/modules/growth/metadata.ts     |  6 +-
 package-lock.json                             | 65 +++++++++++++++++++
 2 files changed, 68 insertions(+), 3 deletions(-)

diff --git a/apps/marketing/worker/src/modules/growth/metadata.ts b/apps/marketing/worker/src/modules/growth/metadata.ts
index 239bdd6..c763983 100644
--- a/apps/marketing/worker/src/modules/growth/metadata.ts
+++ b/apps/marketing/worker/src/modules/growth/metadata.ts
@@ -29,7 +29,7 @@ export interface PageMetadata {
 
 /** Matches <meta property="og:title" content="..."> in either attribute order. */
 function metaContent(html: string, key: string): string | null {
-  const escaped = key.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\$&');
+  const escaped = key.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
   const patterns = [
     new RegExp(`<meta[^>]+(?:property|name)\\s*=\\s*["']${escaped}["'][^>]*?content\\s*=\\s*["']([^"']*)["']`, 'i'),
     new RegExp(`<meta[^>]+content\\s*=\\s*["']([^"']*)["'][^>]*?(?:property|name)\\s*=\\s*["']${escaped}["']`, 'i'),
@@ -51,7 +51,7 @@ function decodeEntities(value: string): string {
 }
 
 function canonicalOf(html: string): string | null {
-  const m = html.match(/<link[^>]+rel\\s*=\\s*["']canonical["'][^>]*?href\\s*=\\s*["']([^"']*)["']/i);
+  const m = html.match(/<link[^>]+rel\s*=\s*["']canonical["'][^>]*?href\s*=\s*["']([^"']*)["']/i);
   return m?.[1] ? decodeEntities(m[1].trim()) : null;
 }
 
@@ -59,7 +59,7 @@ function canonicalOf(html: string): string | null {
 export function schemaTypes(html: string): string[] {
   const types = new Set<string>();
   const blocks = html.matchAll(
-    /<script[^>]+type\\s*=\\s*["']application\/ld\\+json["'][^>]*>([\\s\\S]*?)<\/script>/gi,
+    /<script[^>]+type\s*=\s*["']application\/ld\+json["'][^>]*>([\s\S]*?)<\/script>/gi,
   );
 
   const collect = (node: unknown) => {
