{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksPlan": {
      "phases": {
        "install": {
          "cmds": ["npm install --include=dev"]
        }
      }
    }
  },
  "deploy": {
    "startCommand": "node start-selector.js",
    "healthcheckPath": "/"
  }
}
