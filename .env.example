# ============================================================
# VowOS / RobertsEnterprises — Current Environment Contract
# ============================================================
#
# Copy only the variables required by the environment you are configuring.
# Never commit real credentials. Never expose server-only secrets through VITE_*
# variables because Vite variables are compiled into the browser bundle.
#
# Canonical production origins:
#   Platform/marketing: https://vowos.bridgebox.ai
#   Public demo:        https://vowos.bridgebox.ai/demo
#   Platform owner:     https://vowos.bridgebox.ai/platform
#   Tenant pattern:     https://{slug}.vowos.bridgebox.ai
#   Roberts tenant:     https://robertsenterprises.vowos.bridgebox.ai
# ============================================================

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=production
# Railway sets PORT for the public web process. The worker is supervised on
# the internal runtime port by start-selector.js; do not hardcode a production
# public port unless the deployment platform requires it.

# ── Supabase data plane — REQUIRED for the current VowOS app ─
# These two VITE_* values are intentionally publishable browser configuration.
# They are NOT privileged database credentials.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-only privileged credential used by trusted background jobs and
# canonical tenant resolution when configured. NEVER prefix this with VITE_.
# Never return this value from an API endpoint or place it in browser storage.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# ── GitHub Actions production audit ──────────────────────────
# These are repository ACTIONS SECRETS, not values that should be committed.
# GitHub: Settings → Secrets and variables → Actions → Repository secrets
# SUPABASE_URL may be the same project URL as VITE_SUPABASE_URL.
SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY is reused by the trusted production-audit workflow.
# Do not place a real value in this example file.

# ── Demo narration (server only; optional) ───────────────────
ELEVENLABS_API_KEY=replace-with-server-only-key
ELEVENLABS_VOICE_ID=FFIa0EpESD5acerigJF7
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# The public demo calls the VowOS server-side narration proxy. The API key must
# never be exposed as VITE_ELEVENLABS_API_KEY or embedded in the frontend.

# ── Optional external providers ──────────────────────────────
# Provider secrets/tokens must remain server-side and should be added only when
# the corresponding secure integration flow is implemented/configured.
# Placeholder OAuth endpoints intentionally fail closed rather than logging
# authorization codes or redirecting users to localhost.

# Examples retained for configured provider modules only:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Legacy/secondary services ────────────────────────────────
# Some older packages in this monorepo may still document DATABASE_URL,
# JWT_SECRET, VITE_API_URL, ADMIN_SEED_SECRET, or CORS_ORIGIN. Do not assume
# those variables configure the current apps/marketing VowOS runtime. Review
# the specific package before using legacy environment settings.

# ============================================================
# REQUIRED PRODUCTION SAFETY CHECKS
# ============================================================
# 1. No real secret appears in Git, frontend bundles, logs, or public APIs.
# 2. /api/tenant-config returns only the publishable Supabase anon key.
# 3. /api/health/unified returns HTTP 200 only when the supervised worker is
#    ready enough to serve the current VowOS data plane.
# 4. The official public demo remains https://vowos.bridgebox.ai/demo.
# 5. Production organizations use {slug}.vowos.bridgebox.ai and never inherit
#    demo data-plane state from a previous browser session.
