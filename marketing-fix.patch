+      //   VITE_LIVE_APP_ORIGIN ?? "https://robertsenterprises.bridgebox.ai"
+      // and reads that env var through `import.meta.env[key]` with a *dynamic*
+      // key, which Vite cannot statically replace — so at runtime it is always
+      // undefined and the hardcoded tenant origin always wins. Its "Sign in" and
+      // "Live app" controls are <button>s that navigate via JS (not <a href>),
+      // so rewriting anchors alone never reached them. We intercept the click in
+      // the capture phase, before the bundle's own handler, and route to the
+      // correct same-origin destination.
+      //
+      // Do not delete this without re-exporting the bundle with a correct
+      // VITE_LIVE_APP_ORIGIN baked in. See DESIGN_LOCK.md.
       (() => {
-        const LIVE_DEMO_APP = '/demoapp';
-        const ROBERTS_HOSTS = new Set([
-          'robertsenterprises.bridgebox.ai',
-          'robertsenterprises.vowos.bridgebox.ai',
-        ]);
+        const ROUTES = {
+          liveApp: '/demoapp',   // isolated full-access synthetic sandbox
+          signIn: '/login',      // real staff auth on the marketing origin
+          demo: '/demo',         // guided demo launcher
+          request: '/demo-request',
+        };
+
+        // Hosts we must never navigate to from the public marketing site:
+        // a real tenant, plus the *.vowos.bridgebox.ai family, which has NO DNS
+        // records (NXDOMAIN) — see DESIGN_LOCK.md.
+        const isForbiddenHost = (hostname) => {
+          const h = (hostname || '').toLowerCase();
+          return h === 'robertsenterprises.bridgebox.ai' || h.endsWith('.vowos.bridgebox.ai');
+        };
+
+        // Map visible control text to the destination it should actually go to.
+        // Order matters: most specific first.
+        const routeForText = (raw) => {
+          const text = (raw || '').trim().toLowerCase();
+          if (!text || text.length > 60) return null;
+          if (text.includes('book a demo') || text.includes('request a plan') || text.includes('start free trial')) {
+            return ROUTES.request + '?type=' + (text.includes('plan') ? 'PLAN' : 'DEMO');
+          }
+          if (text.includes('live demo') || text.includes('see vowos in action')) return ROUTES.demo;
+          if (text.includes('live app') || text.includes('launch app') || text.includes('open app')) return ROUTES.liveApp;
+          if (text.includes('sign in') || text.includes('sign-in') || text.includes('log in')) return ROUTES.signIn;
+          return null;
+        };
 
-        const isLiveAppIntent = (anchor) => {
-          if (!anchor) return false;
-          const text = (anchor.textContent || '').trim().toLowerCase();
+        const routeForAnchor = (anchor) => {
           let url;
           try {
             url = new URL(anchor.getAttribute('href') || '', window.location.href);
           } catch {
-            return false;
+            return null;
           }
-
-          return (
-            text.includes('live app') ||
-            text.includes('launch app') ||
-            text.includes('open app') ||
-            url.pathname === '/app' ||
-            ROBERTS_HOSTS.has(url.hostname.toLowerCase())
-          );
+          if (url.pathname === '/app') return ROUTES.liveApp;
+          if (isForbiddenHost(url.hostname)) {
+            // Preserve intent where we can infer it, otherwise land on the sandbox.
+            return routeForText(anchor.textContent) || ROUTES.liveApp;
+          }
+          return null;
         };
 
         const rewritePublicLiveAppLinks = (root = document) => {
           root.querySelectorAll?.('a[href]').forEach((anchor) => {
-            if (isLiveAppIntent(anchor)) {
-              anchor.setAttribute('href', LIVE_DEMO_APP);
+            const dest = routeForAnchor(anchor);
+            if (dest) {
+              anchor.setAttribute('href', dest);
               anchor.removeAttribute('target');
             }
           });
         };
 
         document.addEventListener('click', (event) => {
-          const anchor = event.target?.closest?.('a[href], button');
-          if (!anchor) return;
-          
-          const text = (anchor.textContent || '').trim().toLowerCase();
-          if (text.includes('book a demo') || text.includes('request a plan') || text.includes('start free trial')) {
-            event.preventDefault();
-            event.stopPropagation();
-            window.location.assign('/demo-request?type=' + (text.includes('plan') ? 'PLAN' : 'DEMO'));
-            return;
-          }
+          const control = event.target?.closest?.('a[href], button, [role="button"]');
+          if (!control) return;
 
-          if (anchor.tagName === 'A' && isLiveAppIntent(anchor)) {
-            event.preventDefault();
-            event.stopPropagation();
-            window.location.assign(LIVE_DEMO_APP);
-          }
+          // Anchors pointing at a forbidden host are corrected first, so a
+          // mislabelled link can never escape the origin.
+          const dest =
+            (control.tagName === 'A' ? routeForAnchor(control) : null) || routeForText(control.textContent);
+          if (!dest) return;
+
+          event.preventDefault();
+          event.stopPropagation();
+          window.location.assign(dest);
         }, true);
 
         const guardHistory = () => {
           if (window.location.pathname === '/app') {
-            window.location.assign(LIVE_DEMO_APP);
+            window.location.assign(ROUTES.liveApp);
           }
         };
 
