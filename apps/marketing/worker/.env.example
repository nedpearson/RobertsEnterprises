NODE_ENV=development
PORT=8080

# Supabase / tenant data planes
VITE_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_DEMO_SUPABASE_URL=
DEMO_SUPABASE_SERVICE_ROLE_KEY=

# 32-byte integration secret-encryption key. Use either 64 hex chars or base64.
# Generate, for example: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

# Public deployment URLs
MARKETING_WORKER_PUBLIC_URL=http://localhost:8080
MARKETING_APP_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://robertsenterprises.bridgebox.ai,https://vowos.bridgebox.ai

# Meta Business / Facebook / Instagram
META_APP_ID=
META_APP_SECRET=
# Override only if your approved Meta app requires a versioned/special authorization endpoint.
META_OAUTH_AUTHORIZE_URL=https://www.facebook.com/dialog/oauth
META_OAUTH_TOKEN_URL=https://graph.facebook.com/oauth/access_token
META_VERIFY_URL=https://graph.facebook.com/me?fields=id,name
# Optional override. Space or comma separated.
META_OAUTH_SCOPES=ads_read ads_management business_management pages_show_list pages_read_engagement instagram_basic instagram_manage_insights leads_retrieval

# Google Ads + GA4 + Business Profile + Search Console + Merchant Center + YouTube + Tag Manager
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional: override the default Google scope bundle if your consent-screen review is staged/incremental.
GOOGLE_OAUTH_SCOPES=

# TikTok for Business. TikTok authorization endpoints/scopes depend on the approved API-for-Business app.
# Configure these from the current TikTok developer portal for the Roberts/VowOS application.
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_AUTHORIZE_URL=
TIKTOK_OAUTH_TOKEN_URL=
TIKTOK_VERIFY_URL=
TIKTOK_OAUTH_SCOPES=
TIKTOK_CLIENT_ID_PARAM=client_key
TIKTOK_CLIENT_SECRET_PARAM=client_secret

# Pinterest Business
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_OAUTH_SCOPES=ads:read ads:write boards:read pins:read user_accounts:read catalogs:read

# LinkedIn Campaign Manager
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Add approved Marketing API scopes here after LinkedIn grants access.
LINKEDIN_OAUTH_SCOPES=openid profile email

# Shopify standalone VowOS connection
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_OAUTH_SCOPES=read_products read_inventory read_orders read_locations read_customers

# Klaviyo
KLAVIYO_API_REVISION=2025-07-15
KLAVIYO_VERIFY_URL=https://a.klaviyo.com/api/accounts/

# CallRail / call tracking
CALLRAIL_VERIFY_URL=https://api.callrail.com/v3/a.json
