{
  "name": "roberts-enterprises",
  "private": true,
  "version": "1.0.0",
  "description": "VowOS — Roberts Enterprises bridal retail platform (monorepo)",
  "workspaces": [
    "apps/*",
    "apps/marketing/worker",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace vite_react_shadcn_ts",
    "build": "npm run build --workspace vite_react_shadcn_ts && npm run build --workspace worker",
    "start": "node start-selector.js",
    "lint": "npm run lint --workspaces --if-present",
    "security:scan": "node scripts/security-scan.mjs",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "appointments:backfill": "node scripts/powerful-form-backfill.mjs",
    "certify": "npm run security:scan && npm run test:scripts && node --check start-selector.js && npm run certify --workspace vite_react_shadcn_ts && npm run build --workspace worker && npm run test --workspace worker && npm run test:guard",
    "test:guard": "playwright test --config=playwright.guard.config.ts",
    "test:e2e": "node tests/e2e/runner.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "uuid": "^11.1.1",
    "react-router": "^7.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express-rate-limit": "^8.6.2",
    "puppeteer-core": "^25.8.0",
    "react-router-dom": "^7.18.2",
    "vite": "^8.2.1"
  }
}
