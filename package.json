{
  "name": "roberts-enterprises",
  "private": true,
  "version": "1.0.0",
  "description": "VowOS — Roberts Enterprises bridal retail platform (monorepo)",
  "workspaces": [
    "apps/*",
    "apps/marketing/worker",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace vite_react_shadcn_ts",
    "build": "npm run build --workspace vite_react_shadcn_ts && npm run build --workspace worker",
    "start": "node start-selector.js",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "uuid": "^11.1.1",
    "react-router": "^7.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "react-router-dom": "^7.18.2",
    "vite": "^8.2.1"
  }
}
