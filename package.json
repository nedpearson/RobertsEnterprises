{
  "name": "roberts-enterprises",
  "private": true,
  "version": "1.0.0",
  "description": "VowOS — Roberts Enterprises bridal retail platform (monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web & npm run start:dev --workspace apps/api",
    "build": "npm run build --workspace apps/web",
    "migrate": "npm run migrate --workspace apps/api",
    "start": "node start-selector.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  },
  "overrides": {
    "esbuild": "^0.25.0",
    "uuid": "^11.1.1",
    "react-router": "^7.18.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "react-router-dom": "^7.18.2",
    "vite": "^8.2.1"
  }
}
